{{!-- templates/chat/attack-roll.hbs --}}
<div class="icon-chat-card icon-chat-card--attack
            {{#if isCrit}}icon-chat-card--crit
            {{else}}{{#if isHit}}icon-chat-card--hit{{else}}{{#if (icon-eq isHit false)}}icon-chat-card--miss{{/if}}{{/if}}{{/if}}">

  <div class="icon-chat-card__header">
    <strong class="icon-chat-card__ability">{{abilityName}}</strong>
    {{#if costLabel}}<span class="icon-badge">{{costLabel}}</span>{{/if}}
    {{#if tagsHtml}}<span class="icon-chat-card__tags">{{{tagsHtml}}}</span>{{/if}}
  </div>
  {{#if areaHtml}}{{{areaHtml}}}{{/if}}

  {{!-- Dice row (dimmed when every target evaded: the d20 doesn't count) --}}
  <div class="icon-chat-card__dice {{#if evaded}}icon-chat-card__dice--evaded{{/if}}" {{#if evaded}}title="Every target evaded: this d20 doesn't count"{{/if}}>
    <span class="icon-chat-die icon-chat-die--d20 {{#if isCrit}}icon-chat-die--crit{{/if}}">{{d20}}</span>
    {{#if modifierStr}}
      <span class="icon-chat-card__operator">{{#if isPositive}}+{{else}}−{{/if}}</span>
      <span class="icon-chat-die icon-chat-die--boon {{#unless isPositive}}icon-chat-die--curse{{/unless}}">
        {{absModifier}}
      </span>
      <small class="icon-chat-card__boon-label">{{boonCurseLabel}}</small>
    {{/if}}
    <span class="icon-chat-card__operator">=</span>
    <span class="icon-chat-card__total">{{total}}</span>
    {{#if defense}}
      <span class="icon-chat-card__vs">vs DEF {{defense}}</span>
    {{/if}}
    {{#if thresholdNote}}<span class="icon-chat-card__vs" title="Crit / exceed thresholds of this roll (Soulfire, Arenheir or set in the attack dialog)">{{thresholdNote}}</span>{{/if}}
  </div>

  {{!-- Evasion (d6 per target with Evasion, before the attack roll — defenses.mjs) --}}
  {{#if evasionHtml}}{{{evasionHtml}}}{{/if}}

  {{!-- Result --}}
  <div class="icon-chat-card__result">
    {{#if evaded}}
      <strong class="icon-chat-card__result-label icon-chat-card__result-label--miss">MISS — evaded</strong>
      <small class="icon-chat-card__result-note">Every target evaded: the d20 above doesn't count. Effects that don't need a hit still apply.</small>
    {{else if isCrit}}
      <strong class="icon-chat-card__result-label icon-chat-card__result-label--crit">CRITICAL HIT</strong>
    {{else if isHit}}
      <strong class="icon-chat-card__result-label icon-chat-card__result-label--hit">HIT</strong>
    {{else if (icon-eq isHit false)}}
      <strong class="icon-chat-card__result-label icon-chat-card__result-label--miss">MISS</strong>
    {{else}}
      <strong class="icon-chat-card__result-label">Total: {{total}}</strong>
    {{/if}}
  </div>

  {{!-- Relic invokes (raw d20 vs threshold, p.245) --}}
  {{#if relicInvokeHtml}}{{{relicInvokeHtml}}}{{/if}}

  {{!-- Ability effects (shown inline for quick reference) --}}
  {{#each effects as |e|}}
    <div class="icon-chat-card__effect-block {{#if e.infuse}}icon-chat-card__effect-block--infuse{{else}}icon-chat-card__effect-block--combo{{/if}}">
      <span class="icon-chat-card__effect-label"><i class="fa-solid {{#if e.infuse}}fa-wand-sparkles{{else}}fa-bolt{{/if}}"></i> {{e.label}}</span>
      <span class="icon-chat-card__effect-text">{{{e.text}}}</span>
    </div>
  {{/each}}
  {{#if hitEffect}}
    <div class="icon-chat-card__effect-block {{#unless isHit}}icon-chat-card__effect-block--dim{{/unless}}">
      <span class="icon-chat-card__effect-label">Hit</span>
      <span class="icon-chat-card__effect-text">{{{hitEffect}}}</span>
    </div>
  {{/if}}
  {{#if missEffect}}
    <div class="icon-chat-card__effect-block {{#if isHit}}icon-chat-card__effect-block--dim{{/if}}">
      <span class="icon-chat-card__effect-label">Miss</span>
      <span class="icon-chat-card__effect-text">{{{missEffect}}}</span>
    </div>
  {{/if}}
  {{!-- Unlocked talent: its lines that are not a Hit / Miss / Exceed / Crit add-on --}}
  {{#each talentEffects as |e|}}
    <div class="icon-chat-card__effect-block">
      <span class="icon-chat-card__effect-label">{{e.label}}</span>
      <span class="icon-chat-card__effect-text">{{{e.text}}}</span>
    </div>
  {{/each}}
  {{#if exceedEffect}}
    {{#if isExceed}}
      <div class="icon-chat-card__effect-block icon-chat-card__effect-block--exceed">
        <span class="icon-chat-card__effect-label">Exceed ({{exceedAt}}+)</span>
        <span class="icon-chat-card__effect-text">{{{exceedEffect}}}</span>
      </div>
    {{/if}}
  {{/if}}
  {{#if critEffect}}
    {{#if isCrit}}
      <div class="icon-chat-card__effect-block icon-chat-card__effect-block--crit">
        <span class="icon-chat-card__effect-label">Crit{{#if thresholdNote}} ({{critAt}}+){{/if}}</span>
        <span class="icon-chat-card__effect-text">{{{critEffect}}}</span>
      </div>
    {{/if}}
  {{/if}}
  {{!-- Relic reminders that apply to this attack --}}
  {{#if relicNotesHtml}}{{{relicNotesHtml}}}{{/if}}
  {{!-- Inflicted statuses: a button per status and target (ability-statuses.mjs) --}}
  {{#if statusHtml}}{{{statusHtml}}}{{/if}}
</div>
