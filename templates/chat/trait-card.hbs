{{!-- templates/chat/trait-card.hbs — Show in Chat for a trait --}}
<div class="icon-chat-card icon-chat-card--trait icon-class--{{tr.class}}">
  <div class="icon-chat-card__header">
    <strong class="icon-chat-card__action">{{tr.name}}</strong>
    {{#if tr.jobName}}<span class="icon-badge icon-class--{{tr.class}}">{{tr.jobName}}</span>{{/if}}
    <span class="icon-badge icon-badge--chapter">Ch {{tr.chapter}}</span>
    <span class="icon-badge">Trait</span>
  </div>
  {{#if tr.description}}
    <div class="icon-chat-card__desc">{{{tr.description}}}</div>
  {{/if}}
</div>
