{{!-- templates/chat/great-wheel-card.hbs — a Seer's card played from the hand (great-wheel.mjs, R36b, p.199) --}}
<div class="icon-chat-card icon-chat-card--great-wheel icon-class--mendicant">
  <div class="icon-chat-card__header">
    <strong class="icon-chat-card__action">{{rank}} — {{arcana}}</strong>
    <span class="icon-badge">Great Wheel</span>
    <span class="icon-badge">p.{{page}}</span>
  </div>
  <div class="icon-great-wheel-card__body">
    {{#if img}}<img class="icon-great-wheel-card__img" src="{{img}}" alt="{{cardName}}" width="48">{{/if}}
    <div class="icon-chat-card__desc">
      <p class="icon-great-wheel-card__played"><small>{{cardName}}{{#if from}} · from {{from}}{{/if}}{{#if to}} → {{to}}{{/if}}</small></p>
      <p>{{{effect}}}</p>
    </div>
  </div>
  <details class="icon-great-wheel-card__foretell">
    <summary><small>Foretell (p.{{page}})</small></summary>
    <p><small>{{{foretell}}}</small></p>
  </details>
  {{!-- R36c: the ally it was foretold on (the targets when played), and the area of the card --}}
  <p class="icon-great-wheel-card__targets">
    {{#if targets.length}}
      <small><i class="fa-solid fa-crosshairs"></i> Foretold on:</small>
      {{#each targets}}<span class="icon-great-wheel-card__target">{{#if this.img}}<img class="icon-chat-card__target-img" src="{{this.img}}" alt="" width="20" height="20">{{/if}}<strong>{{this.name}}</strong></span>{{/each}}
    {{else}}
      <small><i class="fa-solid fa-crosshairs"></i> No ally was targeted: target the ally, then use the buttons.</small>
    {{/if}}
  </p>
  {{#if area}}
    <div class="icon-chat-card__area">
      <button type="button" class="icon-btn icon-btn--sm icon-btn--area" data-action="greatWheelArea" data-value="{{area.value}}"
              data-actor-uuid="{{area.actorUuid}}" data-token-id="{{area.tokenId}}"
              title="Place the {{area.label}} on the ally{{#unless area.tokenId}} (target them first){{/unless}}; the allies in it become the targets, for the Blessed button">
        <i class="fa-solid fa-bullseye"></i> Place {{area.label}}
      </button>
    </div>
  {{/if}}
  {{#if noActor}}
    <p class="icon-great-wheel-card__hint"><small><i class="fa-solid fa-circle-info"></i> Select the Seer's token (or set your character) before playing a card to get its Gain buttons.</small></p>
  {{/if}}
  {{#if statusHtml}}{{{statusHtml}}}{{/if}}
</div>
