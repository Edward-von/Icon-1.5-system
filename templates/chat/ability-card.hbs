{{!-- templates/chat/ability-card.hbs — Show in Chat for an ability --}}
<div class="icon-chat-card icon-chat-card--ability {{#if comboMode}}icon-chat-card--combo{{/if}} icon-class--{{ab.class}}">
  <div class="icon-chat-card__header">
    <strong class="icon-chat-card__action">{{ab.name}}</strong>
    {{#if ab.jobName}}<span class="icon-badge icon-class--{{ab.class}}">{{ab.jobName}}</span>{{/if}}
    <span class="icon-badge icon-badge--chapter">Ch {{ab.chapter}}</span>
    <span class="icon-badge">{{ab.cost}}</span>
    {{#if comboMode}}<span class="icon-badge icon-badge--combo">⚡ COMBO</span>{{/if}}
    {{#icon-gt ab.talentSelected 0}}
      <span class="icon-badge icon-badge--primary">Talent {{#icon-eq ab.talentSelected 1}}I{{else}}II{{/icon-eq}}</span>
    {{/icon-gt}}
    {{#if ab.masteryUnlocked}}<span class="icon-badge icon-badge--primary">★ Mastered</span>{{/if}}
    {{#if ab.powerDie.active}}<span class="icon-badge" title="Power die (current ticks)">🎲 d{{ab.powerDie.faces}}: {{ab.powerDie.value}}</span>{{/if}}
  </div>

  {{#if comboMode}}
    {{!-- Combo version: tags still apply (they describe the ability, not the
         normal-vs-combo text), then the combo effect. --}}
    {{#if ab.tags.length}}
      <div class="icon-chat-card__tags">
        {{#each ab.tags as |tag|}}
          <span class="icon-tag icon-tag--small icon-tag--rule {{#if tag.upgraded}}icon-tag--upgraded{{/if}}"
                {{#if tag.tooltip}}data-tooltip="{{tag.tooltip}}"{{/if}}>{{tag.label}}</span>
        {{/each}}
      </div>
    {{/if}}
    {{#if ab.comboEffect}}
      <div class="icon-chat-card__desc">{{{ab.comboEffect}}}</div>
    {{/if}}
    {{!-- Talents / mastery are permanent upgrades of the ability — they still
         apply (and must be readable) when the combo version is used. --}}
    {{#if ab.hasTalent1}}<p><strong>Talent I:</strong> {{{ab.talent1}}}</p>{{/if}}
    {{#if ab.hasTalent2}}<p><strong>Talent II:</strong> {{{ab.talent2}}}</p>{{/if}}
    {{#if ab.hasMastery}}<p><strong>★ Mastery:</strong> {{{ab.mastery}}}</p>{{/if}}
    {{#each ab.relicReminders as |rr|}}<p class="icon-ability-relic"><strong class="icon-ability-relic__label" title="From the relic {{rr.relic}}, rank {{rr.rankLabel}}">✦ {{rr.relic}} {{rr.rankLabel}}:</strong> {{{rr.text}}}</p>{{/each}}
  {{else}}
    {{!-- Normal version --}}
    {{#if ab.tags.length}}
      <div class="icon-chat-card__tags">
        {{#each ab.tags as |tag|}}
          <span class="icon-tag icon-tag--small icon-tag--rule {{#if tag.upgraded}}icon-tag--upgraded{{/if}}"
                {{#if tag.tooltip}}data-tooltip="{{tag.tooltip}}"{{/if}}>{{tag.label}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{#if ab.hasDesc}}
      <div class="icon-chat-card__desc">{{{ab.description}}}</div>
    {{/if}}

    {{#if ab.hasTrigger}}<p><strong>Trigger:</strong> {{{ab.trigger}}}</p>{{/if}}
    {{!-- Same order as the sheet: attacks Hit/Miss/Area then the rules blocks; non-attacks blocks then Area. --}}
    {{#if ab.hasHit}}<p><strong>Hit:</strong> {{{ab.hitEffect}}}</p>{{/if}}
    {{#if ab.hasMiss}}<p><strong>Miss:</strong> {{{ab.missEffect}}}</p>{{/if}}
    {{#if ab.hasHit}}{{#if ab.hasArea}}<p><strong>Area:</strong> {{{ab.areaEffect}}}</p>{{/if}}{{/if}}
    {{#each ab.sections as |sec|}}<p class="icon-ability-section"><strong>{{sec.label}}:</strong> {{{sec.text}}}</p>{{/each}}
    {{#unless ab.hasHit}}{{#if ab.hasArea}}<p><strong>Area:</strong> {{{ab.areaEffect}}}</p>{{/if}}{{/unless}}
    {{#if ab.hasCharge}}<p><strong>Charge:</strong> {{{ab.chargeEffect}}}</p>{{/if}}
    {{#if ab.hasHeroic}}<p><strong>Heroic:</strong> {{{ab.heroicEffect}}}</p>{{/if}}
    {{#if ab.hasExceed}}<p><strong>Exceed (15+):</strong> {{{ab.exceedEffect}}}</p>{{/if}}
    {{#if ab.hasCollide}}<p><strong>Collide:</strong> {{{ab.collideEffect}}}</p>{{/if}}
    {{#if ab.hasSlay}}<p><strong>Slay:</strong> {{{ab.slayEffect}}}</p>{{/if}}
    {{#if ab.hasCrit}}<p><strong>Crit:</strong> {{{ab.critEffect}}}</p>{{/if}}
    {{#if ab.hasFinish}}<p><strong>Finishing Blow:</strong> {{{ab.finishingBlowEffect}}}</p>{{/if}}
    {{#if ab.hasComeback}}<p><strong>Comeback:</strong> {{{ab.comebackEffect}}}</p>{{/if}}
    {{#if ab.hasTalent1}}<p><strong>Talent I:</strong> {{{ab.talent1}}}</p>{{/if}}
    {{#if ab.hasTalent2}}<p><strong>Talent II:</strong> {{{ab.talent2}}}</p>{{/if}}
    {{#if ab.hasMastery}}<p><strong>★ Mastery:</strong> {{{ab.mastery}}}</p>{{/if}}
    {{#each ab.relicReminders as |rr|}}<p class="icon-ability-relic"><strong class="icon-ability-relic__label" title="From the relic {{rr.relic}}, rank {{rr.rankLabel}}">✦ {{rr.relic}} {{rr.rankLabel}}:</strong> {{{rr.text}}}</p>{{/each}}
  {{/if}}
  {{!-- Inflicted statuses: a button per status and target (ability-statuses.mjs) --}}
  {{#if statusHtml}}{{{statusHtml}}}{{/if}}
</div>
