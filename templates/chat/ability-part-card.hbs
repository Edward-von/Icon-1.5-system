{{!-- templates/chat/ability-part-card.hbs — one upgrade of an ability posted on
     its own (unlocked mastery or selected talent), from the button beside it
     on the PC sheet's ability preview --}}
<div class="icon-chat-card icon-chat-card--ability icon-class--{{pc.class}}">
  <div class="icon-chat-card__header">
    <strong class="icon-chat-card__action">{{pc.name}}<small class="icon-chat-card__combo-of">{{pc.label}}{{#if pc.title}}: {{pc.title}}{{/if}}</small></strong>
    {{#if pc.jobName}}<span class="icon-badge icon-class--{{pc.class}}">{{pc.jobName}}</span>{{/if}}
    <span class="icon-badge icon-badge--chapter">Ch {{pc.chapter}}</span>
    <span class="icon-badge icon-badge--primary">{{#if (icon-eq pc.label "Mastery")}}★ {{/if}}{{pc.label}}</span>
  </div>
  <p><strong>{{#if (icon-eq pc.label "Mastery")}}★ {{/if}}{{pc.label}}:</strong> {{{pc.text}}}</p>
  {{#if pc.statusHtml}}{{{pc.statusHtml}}}{{/if}}
</div>
