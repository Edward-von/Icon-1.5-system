{{!-- item-header.hbs --}}
<header class="icon-sheet__header icon-item-header {{#if system.class}}icon-class--{{system.class}}{{/if}}">
  <div class="icon-band icon-item-header__band"></div>
  <img class="icon-sheet__portrait icon-sheet__portrait--sm"
       src="{{item.img}}" alt="{{item.name}}"
       data-edit="img" {{#unless isEditable}}disabled{{/unless}}>
  <div class="icon-sheet__identity">
    <input class="icon-sheet__name" type="text" name="name"
           value="{{item.name}}" {{#unless isEditable}}disabled{{/unless}}>
    <div class="icon-sheet__badges">
      <span class="icon-badge icon-badge--type">{{itemType}}</span>
      {{!-- class badge for job-related items --}}
      {{#if system.class}}
        <span class="icon-badge icon-class--{{system.class}}">{{system.class}}</span>
      {{/if}}
      {{#if system.jobName}}
        <span class="icon-badge">{{system.jobName}}</span>
      {{/if}}
      {{#if system.chapter}}
        <span class="icon-badge">Ch {{system.chapter}}</span>
      {{/if}}
      {{#if system.bondName}}
        <span class="icon-badge">{{system.bondName}}</span>
      {{/if}}
      {{#if canShowInChat}}
        <button type="button" class="icon-btn icon-btn--sm icon-btn--chat icon-item-header__chat"
                data-action="itemShowInChat" title="Post to chat">💬 Chat</button>
      {{/if}}
    </div>
  </div>
</header>
