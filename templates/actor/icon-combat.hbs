{{!-- icon-combat.hbs --}}
<section class="tab icon-tab icon-tab--combat {{tab.cssClass}}" data-tab="combat" data-group="primary">

  {{!-- HP Bar with wound markers --}}
  <div class="icon-combat-top">
  <div class="icon-section icon-section--hp">
    <div class="icon-hp-bar-wrap">
      <div class="icon-hp-labels">
        <span class="icon-hp-label">HP {{system.combat.hp.value}} / {{system.combat.hp.max}}</span>
        {{#if actor.isBloodied}}<span class="icon-badge icon-badge--bloodied">BLOODIED</span>{{/if}}
      </div>
      {{!-- Bar is always the BASE max (4 × VIT) wide: 4 segments of VIT each.
           Wounds blacken segments from the right (p. 15 diagram) and the fill
           is measured against the base max so the bloodied line never moves. --}}
      <div class="icon-hp-bar icon-hp-bar--segmented" title="Base max {{system.combat.hp.baseMax}} — {{system.combat.wounds.value}} wound(s)">
        <div class="icon-hp-bar__fill" style="width:{{icon-pct system.combat.hp.value system.combat.hp.baseMax}}"></div>
        {{#each hpSegments as |seg|}}
          <span class="icon-hp-segment {{#if seg.wounded}}icon-hp-segment--wounded{{/if}}"
                style="left:{{seg.left}}%; width:{{seg.width}}%"
                title="{{#if seg.wounded}}Wound {{seg.woundNo}}{{else}}Segment {{seg.i}} ({{seg.hpFrom}}–{{seg.hpTo}} HP){{/if}}"></span>
        {{/each}}
        <div class="icon-hp-empty" style="width: calc(100% - {{icon-pct system.combat.hp.value system.combat.hp.baseMax}})"></div>
        {{!-- Wound threshold markers at 25%, 50%, 75% --}}
        <span class="icon-hp-marker" style="left:25%"  title="Wound 3"></span>
        <span class="icon-hp-marker icon-hp-marker--bloodied" style="left:50%"  title="Bloodied ({{system.combat.hp.bloodied}} HP or less)"></span>
        <span class="icon-hp-marker" style="left:75%"  title="Wound 1"></span>
      </div>
      {{#if isEditable}}
        <div class="icon-hp-controls">
          <label>Current HP</label>
          <input type="number" name="system.combat.hp.value"
                 value="{{system.combat.hp.value}}" min="0" max="{{system.combat.hp.max}}">
        </div>
      {{/if}}
    </div>

    {{!-- Wounds: 4 pips; filled only for wounds actually suffered --}}
    <div class="icon-wounds">
      <label>Wounds</label>
      <div class="icon-boxes">
        {{#each (iconRange 4) as |i|}}
          <span class="icon-wound {{#icon-lte i ../system.combat.wounds.value}}icon-wound--filled{{/icon-lte}}"
                data-action="setWounds" data-value="{{i}}"
                title="Set wounds to {{i}} (click the last filled pip to clear one)"></span>
        {{/each}}
      </div>
      <input type="number" name="system.combat.wounds.value"
             value="{{system.combat.wounds.value}}" min="0" max="4"
             {{#unless isEditable}}disabled{{/unless}}>
    </div>

    {{!-- Vigor — full bar treatment matching HP --}}
    <div class="icon-vigor-wrap">
      <div class="icon-vigor-labels">
        <span class="icon-vigor-label">Vigor {{system.combat.vigor.value}} / {{system.combat.vigor.max}}</span>
      </div>
      <div class="icon-vigor-ticks" style="grid-template-columns: repeat({{system.combat.vigor.max}}, minmax(0, 1fr));">
        {{#each vigorTicks as |t|}}<span class="icon-vigor-tick {{#if t}}icon-vigor-tick--on{{/if}}"></span>{{/each}}
      </div>
      {{#if isEditable}}
        <div class="icon-vigor-controls">
          <label>Current Vigor</label>
          <input type="number" name="system.combat.vigor.value"
                 value="{{system.combat.vigor.value}}" min="0" max="{{system.combat.vigor.max}}">
        </div>
      {{/if}}
    </div>

    {{!-- Class Resources — displayed inline with HP/Vigor for all classes.
         Stalwart=Vigilance, Vagabond=Combo, Mendicant=Blessings, Wright=Aether+Power Dice. --}}
    {{#if primaryJobClass}}
      <div class="icon-resource-section icon-resource-section--inline icon-resource-section--{{primaryJobClass}}">

        {{!-- Stalwart — Vigilance --}}
        {{#if (icon-eq primaryJobClass "stalwart")}}
          <div class="icon-resource-block icon-resource-block--vigilance icon-resource-block--inline">
            <div class="icon-resource-block__header">
              <h4>Vigilance <small>({{system.combat.classResources.vigilance.value}}/{{system.combat.classResources.vigilance.max}})</small></h4>
              {{#if isEditable}}
                <button type="button" class="icon-btn icon-btn--sm" data-action="spendVigilance"
                        title="Spend charges: roll 1d6 each, total reduces damage, charges are deducted">Spend</button>
                <button type="button" class="icon-btn icon-btn--sm" data-action="clearVigilance">Clear</button>
              {{/if}}
            </div>
            <div class="icon-vigilance-track">
              {{#each (iconRange 6) as |i|}}
                <span class="icon-vigilance-pip {{#if (icon-lte i ../system.combat.classResources.vigilance.value)}}icon-vigilance-pip--active{{/if}}"
                      data-action="setVigilance"
                      data-value="{{i}}"
                      title="Set vigilance to {{i}}">⚡</span>
              {{/each}}
            </div>
          </div>
        {{/if}}

        {{!-- Mendicant — Blessing Tokens --}}
        {{#if (icon-eq primaryJobClass "mendicant")}}
          <div class="icon-resource-block icon-resource-block--blessings icon-resource-block--inline">
            <div class="icon-resource-block__header">
              <h4>Blessing Tokens</h4>
              {{#if isEditable}}
                <button type="button" class="icon-btn icon-btn--sm" data-action="clearBlessings">Clear</button>
              {{/if}}
            </div>
            <div class="icon-counter-row">
              <button type="button" class="icon-btn icon-btn--sm" data-action="adjustBlessings" data-delta="-1"
                      {{#unless isEditable}}disabled{{/unless}}>−</button>
              <span class="icon-counter-value">{{system.combat.classResources.blessingTokens.value}}</span>
              <button type="button" class="icon-btn icon-btn--sm" data-action="adjustBlessings" data-delta="1"
                      {{#unless isEditable}}disabled{{/unless}}>+</button>
            </div>
          </div>
        {{/if}}

        {{!-- Wright — Aether + Power Dice --}}
        {{#if (icon-eq primaryJobClass "wright")}}
          <div class="icon-resource-block icon-resource-block--wright icon-resource-block--inline">
            <h4>Aether <small>(+1 at start of your turn; max 6; lost at end of combat)</small></h4>
            <div class="icon-counter-row">
              <button type="button" class="icon-btn icon-btn--sm" data-action="adjustAether" data-delta="-1"
                      {{#unless isEditable}}disabled{{/unless}}>−</button>
              <span class="icon-counter-value">{{system.combat.classResources.aether.value}}</span>
              <button type="button" class="icon-btn icon-btn--sm" data-action="adjustAether" data-delta="1"
                      {{#unless isEditable}}disabled{{/unless}}>+</button>
            </div>
            <div class="icon-resource-block__header">
              <h4>Power Dice</h4>
              {{#if isEditable}}
                <button type="button" class="icon-btn icon-btn--sm" data-action="addPowerDie">+ Die</button>
              {{/if}}
            </div>
            <div class="icon-power-dice">
              {{#each system.combat.classResources.powerDice as |die|}}
                <div class="icon-power-die" data-die-id="{{die.id}}">
                  <button type="button" class="icon-btn icon-btn--sm" data-action="tickPowerDie"
                          data-id="{{die.id}}" data-delta="-1"
                          {{#unless ../isEditable}}disabled{{/unless}}>−</button>
                  <span class="icon-power-die__value">{{die.ticks}}</span>
                  <button type="button" class="icon-btn icon-btn--sm" data-action="tickPowerDie"
                          data-id="{{die.id}}" data-delta="1"
                          {{#unless ../isEditable}}disabled{{/unless}}>+</button>
                  {{#if ../isEditable}}
                    <button type="button" class="icon-btn icon-btn--remove icon-btn--sm" data-action="removePowerDie"
                            data-id="{{die.id}}" title="Remove die">✕</button>
                  {{/if}}
                </div>
              {{/each}}
              {{#unless system.combat.classResources.powerDice.length}}
                <p class="icon-empty">No active power dice.</p>
              {{/unless}}
            </div>
          </div>
        {{/if}}

      </div>
    {{/if}}
  </div>

  {{!-- Stance — ICON allows one active stance at a time. The name is synced to
       a marker effect on the token (IconActor._syncStanceMarker). --}}
  <div class="icon-section icon-stance-section">
    <div class="icon-stance-row">
      <label class="icon-resource__title">Stance
        {{#if system.combat.stance}}<span class="icon-badge icon-badge--primary">active</span>{{/if}}
      </label>
      <input type="text" class="icon-stance-input" name="system.combat.stance"
             value="{{system.combat.stance}}" placeholder="No stance active"
             {{#unless isEditable}}disabled{{/unless}}>
      {{#if isEditable}}
        <button type="button" class="icon-btn icon-btn--sm" data-action="clearStance"
                {{#unless system.combat.stance}}disabled{{/unless}}
                title="Drop the active stance (free action at the start of your turn)">Clear</button>
      {{/if}}
      {{!-- Aura colour: several characters can hold an aura at once and they
            all used to be drawn the same gold. Empty = the class colour. --}}
      <label class="icon-aura-color" title="Colour of this character's aura templates on the map. Leave empty for the class colour.">
        <span>Aura</span>
        <input type="color" name="flags.icon-system.auraColor"
               value="{{auraColor}}" {{#unless isEditable}}disabled{{/unless}}>
        {{#if isEditable}}
          <button type="button" class="icon-btn icon-btn--sm" data-action="resetAuraColor"
                  title="Back to the class colour">↺</button>
        {{/if}}
      </label>
    </div>
  </div>

  {{!-- Basic Actions — the universal actions from p.85, collapsed by default. --}}
  <div class="icon-section icon-basic-actions">
    <details>
      <summary class="icon-section__title icon-basic-actions__summary">Basic Actions <small>(everyone has these)</small></summary>
      <ul class="icon-basic-actions__list">
        <li>
          <span class="icon-basic-actions__name">Standard Move</span>
          <span class="icon-badge">free</span>
          <span class="icon-basic-actions__desc">Move your speed ({{system.combat.speed}}).</span>
        </li>
        <li>
          <span class="icon-basic-actions__name">Dash</span>
          <span class="icon-badge">1 action</span>
          <span class="icon-basic-actions__desc">Dash half your speed, rounded up, ignoring engagement.</span>
        </li>
        <li>
          <span class="icon-basic-actions__name">Interact</span>
          <span class="icon-badge">1 action</span>
          <span class="icon-basic-actions__desc">Interact with the map: pull a lever, open a heavy door, pick up a heavy object…</span>
        </li>
        <li>
          <span class="icon-basic-actions__name">Rescue</span>
          <span class="icon-badge">1 action</span>
          <span class="icon-basic-actions__desc">Help an adjacent defeated ally: they end incapacitated and heal to full HP minus wounds.</span>
        </li>
        <li>
          <span class="icon-basic-actions__name">Light Attack</span>
          <span class="icon-badge">1 action</span>
          {{#if classInfo.basicAttackRange}}<span class="icon-badge" title="Basic attack range of your class ({{classInfo.label}})">Range {{classInfo.basicAttackRange}}</span>{{/if}}
          <span class="icon-basic-actions__desc">On hit: [D] + fray. Miss: fray.</span>
          {{#if isEditable}}
            <span class="icon-basic-actions__btns">
              <button type="button" class="icon-btn icon-btn--sm" data-action="basicAttackRoll" title="Roll the attack (d20 vs Defense)"><i class="fas fa-dice-d20"></i></button>
              <button type="button" class="icon-btn icon-btn--sm" data-action="basicDamageRoll" title="Roll damage"><i class="fas fa-burst"></i></button>
            </span>
          {{/if}}
        </li>
        <li>
          <span class="icon-basic-actions__name">Heavy Attack</span>
          <span class="icon-badge">2 actions</span>
          {{#if classInfo.basicAttackRange}}<span class="icon-badge" title="Basic attack range of your class ({{classInfo.label}})">Range {{classInfo.basicAttackRange}}</span>{{/if}}
          <span class="icon-basic-actions__desc">On hit: 2[D] + fray. Miss: fray.</span>
          {{#if isEditable}}
            <span class="icon-basic-actions__btns">
              <button type="button" class="icon-btn icon-btn--sm" data-action="basicAttackRoll" data-heavy="true" title="Roll the attack (d20 vs Defense)"><i class="fas fa-dice-d20"></i></button>
              <button type="button" class="icon-btn icon-btn--sm" data-action="basicDamageRoll" data-heavy="true" title="Roll damage"><i class="fas fa-burst"></i></button>
            </span>
          {{/if}}
        </li>
        <li>
          <span class="icon-basic-actions__name">Recover</span>
          <span class="icon-badge">2 actions</span>
          <span class="icon-basic-actions__desc">Cure yourself: gain 4 Vigor (Vigor Surge if bloodied), then save vs all statuses.</span>
          {{#if isEditable}}
            <span class="icon-basic-actions__btns">
              <button type="button" class="icon-btn icon-btn--sm" data-action="basicRecover" title="Apply the Vigor gain and post to chat"><i class="fas fa-heart-pulse"></i></button>
            </span>
          {{/if}}
        </li>
      </ul>
    </details>
  </div>

  {{!-- Core stats row --}}
  <div class="icon-section icon-section--stats">
    <div class="icon-stats-grid">
      <div class="icon-stat-block">
        <span class="icon-stat__label">VIT</span>
        <input class="icon-stat__value" type="number" name="system.combat.vit"
               value="{{system.combat.vit}}" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">DEF</span>
        <input class="icon-stat__value" type="number" name="system.combat.defense"
               value="{{system.combat.defense}}" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">SPD</span>
        <input class="icon-stat__value" type="number" name="system.combat.speed"
               value="{{system.combat.speed}}" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">ARM</span>
        <input class="icon-stat__value" type="number" name="system.combat.armor"
               value="{{system.combat.armor}}" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">FRAY</span>
        <input class="icon-stat__value" type="number" name="system.combat.fray"
               value="{{system.combat.fray}}" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">[D]</span>
        <select name="system.combat.damagedie" {{#unless isEditable}}disabled{{/unless}}>
          {{#each config.damageDice as |label key|}}
            <option value="{{key}}" {{#icon-eq key ../system.combat.damagedie}}selected{{/icon-eq}}>{{key}}</option>
          {{/each}}
        </select>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">Level</span>
        <input class="icon-stat__value" type="number" name="system.combat.level"
               value="{{system.combat.level}}" min="0" max="12"
               {{#unless isEditable}}disabled{{/unless}}>
      </div>
      <div class="icon-stat-block">
        <span class="icon-stat__label">Chapter</span>
        <select name="system.combat.chapter" {{#unless isEditable}}disabled{{/unless}}>
          <option value="1" {{#icon-eq system.combat.chapter 1}}selected{{/icon-eq}}>1</option>
          <option value="2" {{#icon-eq system.combat.chapter 2}}selected{{/icon-eq}}>2</option>
          <option value="3" {{#icon-eq system.combat.chapter 3}}selected{{/icon-eq}}>3</option>
        </select>
      </div>
    </div>
    {{#if canLevelUp}}
      <div class="icon-level-up-bar">
        <span class="icon-level-up-available">⬆ LEVEL UP AVAILABLE</span>
        {{#if isEditable}}
          <button type="button" class="icon-btn icon-btn--primary icon-btn--pulse"
                  data-action="levelUp">⬆ Level Up Now</button>
        {{/if}}
      </div>
    {{/if}}
    {{#if isEditable}}
      <div class="icon-save-bar">
        <button type="button" class="icon-btn icon-btn--sm" data-action="rollSave"
                title="Roll a save vs a status effect (1d20, 10+ = success). Mendicants can spend a blessing for +1 boon.">
          🛡 Save Roll
        </button>
      </div>
    {{/if}}
  </div>
  </div>{{!-- /icon-combat-top --}}

  {{!-- Jobs --}}
  <div class="icon-section">
    <div class="icon-section__header">
      <h3 class="icon-section__title">Jobs</h3>
      {{#if isEditable}}
        <button type="button" class="icon-btn icon-btn--add" data-action="addJob">+ Job</button>
      {{/if}}
    </div>
    <div class="icon-jobs-list">
      {{#each system.combat.jobs as |job i|}}
        <div class="icon-job icon-class--{{job.class}} {{#if job.primary}}icon-job--primary{{/if}}">
          <input type="text" name="system.combat.jobs.{{i}}.name"
                 value="{{job.name}}" placeholder="Job name"
                 {{#unless ../isEditable}}disabled{{/unless}}>
          <select name="system.combat.jobs.{{i}}.class" {{#unless ../isEditable}}disabled{{/unless}}>
            <option value="stalwart"  {{#icon-eq job.class "stalwart"}}selected{{/icon-eq}}>Stalwart</option>
            <option value="vagabond"  {{#icon-eq job.class "vagabond"}}selected{{/icon-eq}}>Vagabond</option>
            <option value="mendicant" {{#icon-eq job.class "mendicant"}}selected{{/icon-eq}}>Mendicant</option>
            <option value="wright"    {{#icon-eq job.class "wright"}}selected{{/icon-eq}}>Wright</option>
          </select>
          {{#if job.primary}}
            <span class="icon-badge icon-badge--primary">★ Primary</span>
          {{else}}
            {{#if ../isEditable}}
              <button type="button" class="icon-btn icon-btn--sm"
                      data-action="setPrimaryJob" data-index="{{i}}"
                      title="Switch primary to this job. Traits and Limit Break will be swapped.">
                Set as Primary
              </button>
            {{/if}}
          {{/if}}
          {{#if ../isEditable}}
            <button type="button" class="icon-btn icon-btn--remove"
                    data-action="removeJob" data-index="{{i}}">✕</button>
          {{/if}}
        </div>
      {{/each}}
    </div>
  </div>

  {{!-- Class Rules — collapsible reference for the primary class.
       Shows the keyword/rule definitions relevant to this class's abilities,
       plus the class's special mechanic (Heroics / Combo / Blessings / Aether). --}}
  {{#if classInfo}}
    <div class="icon-section">
      <details class="icon-class-rules-collapsible">
        <summary class="icon-class-rules__summary">
          <strong>{{classInfo.label}}</strong> — Relevant Rules &amp; {{classInfo.specialMechanic.name}}
        </summary>
        <div class="icon-class-rules__body">
          {{#if classInfo.relevantRules.length}}
            <h4>Relevant Rules</h4>
            <ul>
              {{#each classInfo.relevantRules as |r|}}
                <li><strong>{{r.name}}.</strong> {{r.description}}</li>
              {{/each}}
            </ul>
          {{/if}}
          <h4>Special Mechanic — {{classInfo.specialMechanic.name}}</h4>
          <p>{{classInfo.specialMechanic.description}}</p>
          {{#if classInfo.gambit}}
            <p class="notes"><em>{{classInfo.gambit}}</em></p>
          {{/if}}
        </div>
      </details>
    </div>
  {{/if}}

  {{!-- Traits — created from dropped Job Templates / Job items --}}
  <div class="icon-section">
    <h3 class="icon-section__title">Traits</h3>
    {{#if traitItems.length}}
      {{#each traitItems as |trait|}}
        <div class="icon-trait icon-class--{{trait.class}} {{#if trait.isLocked}}icon-trait--locked{{/if}}"
             data-item-id="{{trait.id}}">
          <div class="icon-trait__header">
            <strong>{{trait.name}}</strong>
            {{#if trait.jobName}}
              <span class="icon-badge">{{trait.jobName}}</span>
            {{/if}}
            <span class="icon-badge icon-badge--chapter">Ch {{trait.chapter}}</span>
            {{#if trait.isLocked}}
              <span class="icon-badge icon-badge--locked">🔒 Locked</span>
            {{/if}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--chat"
                    data-action="traitShowInChat" data-item-id="{{trait.id}}"
                    title="Post trait to chat">💬</button>
            {{#if ../isEditable}}
              <button type="button" class="icon-btn icon-btn--remove icon-btn--inline icon-btn--corner"
                      data-action="removeItem" data-item-id="{{trait.id}}"
                      title="Remove trait">×</button>
            {{/if}}
          </div>
          {{#if trait.quick}}
            <div class="icon-trait__quick icon-trait__quick--{{trait.quick.type}}">
              {{#if (icon-eq trait.quick.type "vigilance")}}
                <span class="icon-trait__quick-label">Vigilance {{trait.quick.value}}/{{trait.quick.max}}</span>
                <span class="icon-vigilance-track icon-vigilance-track--inline">
                  {{#each trait.quick.pips as |p|}}
                    <span class="icon-vigilance-pip {{#if p.active}}icon-vigilance-pip--active{{/if}}"
                          data-action="setVigilance" data-value="{{p.i}}" title="Set vigilance to {{p.i}}">⚡</span>
                  {{/each}}
                </span>
                {{#if ../isEditable}}
                  <button type="button" class="icon-btn icon-btn--sm" data-action="spendVigilance"
                          title="Spend charges: roll 1d6 each, total reduces damage">Spend</button>
                {{/if}}
              {{/if}}
              {{#if (icon-eq trait.quick.type "wright")}}
                <span class="icon-trait__quick-label">Aether</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="adjustAether" data-delta="-1" {{#unless ../isEditable}}disabled{{/unless}}>−</button>
                <span class="icon-counter-value">{{trait.quick.aether}}</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="adjustAether" data-delta="1" {{#unless ../isEditable}}disabled{{/unless}}>+</button>
                <span class="icon-trait__quick-label">Power Dice</span>
                {{#each trait.quick.dice as |die|}}
                  <span class="icon-power-die icon-power-die--inline" data-die-id="{{die.id}}">
                    <button type="button" class="icon-btn icon-btn--sm" data-action="tickPowerDie" data-id="{{die.id}}" data-delta="-1" {{#unless ../../isEditable}}disabled{{/unless}}>−</button>
                    <span class="icon-power-die__value">{{die.ticks}}</span>
                    <button type="button" class="icon-btn icon-btn--sm" data-action="tickPowerDie" data-id="{{die.id}}" data-delta="1" {{#unless ../../isEditable}}disabled{{/unless}}>+</button>
                    <button type="button" class="icon-btn icon-btn--sm icon-btn--roll" data-action="rollPowerDie" data-id="{{die.id}}" title="Roll this power die (1d6)">🎲</button>
                  </span>
                {{/each}}
                {{#if ../isEditable}}
                  <button type="button" class="icon-btn icon-btn--sm" data-action="addPowerDie" title="Add a power die">+ Die</button>
                {{/if}}
                <button type="button" class="icon-btn icon-btn--sm icon-btn--roll" data-action="rollPowerDie" title="Roll a power die (1d6)">🎲 Roll</button>
              {{/if}}
              {{#if (icon-eq trait.quick.type "blessings")}}
                <span class="icon-trait__quick-label">Blessing Tokens</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="adjustBlessings" data-delta="-1" {{#unless ../isEditable}}disabled{{/unless}}>−</button>
                <span class="icon-counter-value">{{trait.quick.value}}</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="adjustBlessings" data-delta="1" {{#unless ../isEditable}}disabled{{/unless}}>+</button>
              {{/if}}
              {{#if (icon-eq trait.quick.type "stackedDice")}}
                <span class="icon-trait__quick-label">Stacked Dice {{trait.quick.value}}/{{trait.quick.max}}</span>
                <span class="icon-vigilance-track icon-vigilance-track--inline">
                  {{#each trait.quick.pips as |p|}}
                    <span class="icon-vigilance-pip icon-stacked-die-pip {{#if p.active}}icon-vigilance-pip--active{{/if}}"
                          data-action="setStackedDice" data-value="{{p.i}}" data-max="{{../trait.quick.max}}"
                          title="{{#if p.active}}Spend / drop stacked die{{else}}Gain a stacked die (gamble result becomes 6){{/if}}">🎲</span>
                  {{/each}}
                </span>
              {{/if}}
              {{#if (icon-eq trait.quick.type "combo")}}
                <span class="icon-trait__quick-label">Combo Token</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="toggleComboToken"
                        {{#unless ../isEditable}}disabled{{/unless}}>{{#if trait.quick.value}}● armed{{else}}○ none{{/if}}</button>
              {{/if}}
            </div>
          {{/if}}
          {{#if trait.powerDie}}
            <div class="icon-trait__quick icon-power-die-widget" title="Power die unique to this item. Set it out when the text says so, tick it up or down as the text tells you; at 0 it is discarded.">
              <span class="icon-trait__quick-label">🎲 Power die d{{trait.powerDie.faces}}</span>
              {{#if trait.powerDie.active}}
                <span class="icon-power-die icon-power-die--inline">
                  <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieTick" data-item-id="{{trait.id}}" data-delta="-1" {{#unless ../isEditable}}disabled{{/unless}} title="Tick down">−</button>
                  <span class="icon-power-die__value">{{trait.powerDie.value}}</span>
                  <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieTick" data-item-id="{{trait.id}}" data-delta="1" {{#unless ../isEditable}}disabled{{/unless}} title="Tick up (max {{trait.powerDie.faces}})">+</button>
                </span>
                <button type="button" class="icon-btn icon-btn--sm icon-btn--roll" data-action="itemPowerDieRoll" data-item-id="{{trait.id}}" title="Roll 1d{{trait.powerDie.faces}}">🎲</button>
                <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieSet" data-item-id="{{trait.id}}" data-value="0" {{#unless ../isEditable}}disabled{{/unless}} title="Discard the die">Discard</button>
              {{else}}
                <button type="button" class="icon-btn icon-btn--sm icon-btn--primary" data-action="itemPowerDieSet" data-item-id="{{trait.id}}" data-value="{{trait.powerDie.start}}" {{#unless ../isEditable}}disabled{{/unless}}>Set out at {{trait.powerDie.start}}</button>
              {{/if}}
            </div>
          {{/if}}
          {{#if trait.enrichedDescription}}
            <div class="icon-trait__body icon-editor-wrap">{{{trait.enrichedDescription}}}</div>
          {{/if}}
          {{#if trait.isLocked}}
            <p class="icon-trait__lock-hint">Unlocks at Chapter {{trait.chapter}}.</p>
          {{/if}}
        </div>
      {{/each}}
    {{else}}
      <p class="icon-empty">No traits. Drop a Job Template from the Jobs compendium, or drag a trait item directly onto the sheet.</p>
    {{/if}}
  </div>

  {{!-- Summons attached to this PC --}}
  {{#if summons.length}}
    <div class="icon-section">
      <h3 class="icon-section__title">Summons <small>(click to open)</small></h3>
      <div class="icon-summon-list">
        {{#each summons as |sm|}}
          <button type="button" class="icon-summon-chip" data-action="openSummon" data-actor-id="{{sm.id}}"
                  title="Open {{sm.name}}{{#if sm.source}} — from {{sm.source}}{{/if}}">
            <img src="{{sm.img}}" alt="">
            <span class="icon-summon-chip__name">{{sm.name}}</span>
            {{#if sm.source}}<span class="icon-badge">{{sm.source}}</span>{{/if}}
            {{#if sm.hpMax}}<span class="icon-badge">HP {{sm.hp}}/{{sm.hpMax}}</span>{{/if}}
            {{#if sm.onScene}}<span class="icon-badge icon-badge--primary">on scene</span>{{/if}}
          </button>
        {{/each}}
      </div>
    </div>
  {{/if}}

  {{!-- Equipped Abilities (6 slots, drag-drop) --}}
  <div class="icon-section">
    <div class="icon-section__header">
      <h3 class="icon-section__title">Equipped Abilities <small>(click for details, double-click to open)</small></h3>
      <label class="icon-combo-checkbox {{#if comboActive}}icon-combo-checkbox--active{{/if}}"
             title="{{#if comboActive}}COMBO active — next Show in Chat on a combo ability uses the combo version{{else}}Activate combo token{{/if}}">
        <input type="checkbox" data-action="toggleComboToken" {{#if comboActive}}checked{{/if}}>
        COMBO {{#if comboActive}}ON{{else}}OFF{{/if}}
      </label>
      {{#if isEditable}}
        <button type="button" class="icon-btn icon-btn--sm" data-action="toggleAbilitiesLock"
                title="{{#if abilitiesLocked}}Click to unlock — talent/mastery edits and remove buttons are disabled{{else}}Click to lock — protect equipped abilities from accidental edits{{/if}}">
          {{#if abilitiesLocked}}🔒 Locked{{else}}🔓 Unlocked{{/if}}
        </button>
      {{/if}}
    </div>
    <div class="icon-ability-slots">
      {{#icon-range 0 5}}
        {{#with (lookup ../abilityItems this) as |item|}}
          <div class="icon-ability-slot icon-ability-slot--filled {{icon-class-color item.system.class}}"
               data-slot="{{@index}}" data-item-id="{{item.id}}">
            <span class="icon-ability-slot__name">{{item.name}}</span>
            <span class="icon-ability-slot__cost">{{item.system.cost}}</span>
            {{#if (icon-or (icon-or (icon-gt item.system.talentSelected 0) item.system.masteryUnlocked) item.system.isCombo)}}
              <div class="icon-ability-slot__badges">
                {{#if item.system.isCombo}}
                  <span class="icon-ability-slot__badge icon-ability-slot__badge--combo {{#if ../comboActive}}icon-ability-slot__badge--combo-active{{/if}}"
                        title="Combo ability">⚡</span>
                {{/if}}
                {{#icon-gt item.system.talentSelected 0}}
                  <span class="icon-ability-slot__badge icon-ability-slot__badge--talent"
                        title="Talent {{#icon-eq item.system.talentSelected 1}}I{{else}}II{{/icon-eq}} unlocked">
                    T{{#icon-eq item.system.talentSelected 1}}I{{else}}II{{/icon-eq}}
                  </span>
                {{/icon-gt}}
                {{#if item.system.masteryUnlocked}}
                  <span class="icon-ability-slot__badge icon-ability-slot__badge--mastery"
                        title="Mastery unlocked">★</span>
                {{/if}}
              </div>
            {{/if}}
            {{#if ../isEditable}}{{#unless ../abilitiesLocked}}
              <button type="button" class="icon-btn icon-btn--remove icon-btn--inline icon-btn--corner"
                      data-action="removeItem" data-item-id="{{item.id}}"
                      title="Remove ability">×</button>
            {{/unless}}{{/if}}
          </div>
        {{else}}
          <div class="icon-ability-slot icon-ability-slot--empty" data-slot="{{this}}">
            <span class="icon-ability-slot__hint">Drop ability here</span>
          </div>
        {{/with}}
      {{/icon-range}}
    </div>

    {{!-- Preview panels — one per equipped ability, hidden by default.
         Clicking a slot above toggles the matching panel. --}}
    {{#each abilityDetails as |ab|}}
      <div class="icon-ability-preview icon-class--{{ab.class}} {{#if (icon-and ../comboActive ab.hasCombo)}}icon-ability-preview--combo-active{{/if}}"
           data-ability-id="{{ab.id}}" data-toggle-key="ability-{{ab.id}}" hidden>
        {{#if ../isEditable}}{{#unless ../abilitiesLocked}}
          <button type="button" class="icon-btn icon-btn--remove icon-btn--inline icon-btn--corner icon-btn--corner-lg"
                  data-action="removeItem" data-item-id="{{ab.id}}"
                  title="Remove ability from sheet">×</button>
        {{/unless}}{{/if}}
        <div class="icon-ability-preview__header">
          <strong>{{ab.name}}</strong>
          <span class="icon-badge icon-class--{{ab.class}}">{{ab.jobName}}</span>
          <span class="icon-badge icon-badge--chapter">Ch {{ab.chapter}}</span>
          <span class="icon-badge">{{ab.cost}}</span>
          {{#icon-gt ab.talentSelected 0}}
            <span class="icon-badge icon-badge--primary">Talent {{#icon-eq ab.talentSelected 1}}I{{else}}II{{/icon-eq}}</span>
          {{/icon-gt}}
          {{#if ab.masteryUnlocked}}
            <span class="icon-badge icon-badge--primary">★ Mastered</span>
          {{/if}}
          {{#each ab.tags as |tag|}}
            <span class="icon-tag icon-tag--small icon-tag--rule {{#if tag.upgraded}}icon-tag--upgraded{{/if}}"
                  {{#if tag.tooltip}}data-tooltip="{{tag.tooltip}}"{{/if}}>{{tag.label}}</span>
          {{/each}}
        </div>

        {{!-- Action bar: buttons adapt to ability type (attack/auto-hit/no damage) --}}
        <div class="icon-ability-preview__actions">
          <button type="button" class="icon-btn icon-btn--sm"
                  data-action="abilityShowInChat" data-item-id="{{ab.id}}"
                  title="Post the ability to chat for everyone to see">
            💬 Show in Chat
          </button>
          {{#each ab.infusions as |inf|}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--infuse {{#if inf.armed}}icon-btn--infuse-on{{/if}}"
                    data-action="abilityInfuse" data-item-id="{{ab.id}}" data-label="{{inf.label}}"
                    title="{{#if inf.armed}}Infused and ready — click to take the Aether back{{else}}Spend Aether to use this version ({{inf.label}}){{/if}}{{#if inf.name}} — {{inf.name}}{{/if}}. Aether now: {{inf.aether}}">
              ✨ {{inf.label}}{{#if inf.armed}} — armed{{/if}}
            </button>
          {{/each}}
          {{#each ab.summons as |sm|}}
            <span class="icon-summon-chip" draggable="true"
                  data-summon-uuid="{{sm.uuid}}" data-summon-name="{{sm.name}}"
                  title="Drag {{sm.name}} onto the map to place it (you need permission to create tokens)">
              <img src="{{sm.img}}" alt="" width="18" height="18"> {{sm.name}}
            </span>
          {{/each}}
          {{#if ab.canStance}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--stance {{#if ab.stanceOn}}icon-btn--stance-on{{/if}}"
                    data-action="abilityStance" data-item-id="{{ab.id}}"
                    title="{{#if ab.stanceOn}}You are in this stance — click to drop it{{else}}Take this stance (one at a time, p.104){{/if}}">
              {{#if ab.stanceOn}}🧘 In stance — drop{{else}}🧘 Take stance{{/if}}
            </button>
          {{/if}}
          {{#if ab.canMark}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--mark"
                    data-action="abilityMark" data-item-id="{{ab.id}}"
                    title="Mark the targeted token with this ability (target exactly one token first: hover it and press T)">
              🎯 Mark target
            </button>
            {{#each ab.marks as |m|}}
              <span class="icon-mark-chip" title="Marked by {{ab.name}}">🎯 {{m.targetName}}
                <button type="button" class="icon-mark-chip__x" data-action="removeMark" data-effect-uuid="{{m.uuid}}" title="End this mark">✕</button>
              </span>
            {{/each}}
          {{/if}}
          {{#if ab.areaLabel}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--area"
                    data-action="abilityPlaceArea" data-item-id="{{ab.id}}"
                    title="Place the {{ab.areaLabel}} on the map and target the tokens inside it (right-click / Esc cancels)">
              📐 {{ab.areaLabel}}
            </button>
          {{/if}}
          {{#if ab.isAttack}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--primary"
                    data-action="abilityAttackRoll" data-item-id="{{ab.id}}"
                    title="{{#if ab.isAutoHit}}Auto-hit — skips the d20 and goes to damage{{else}}Roll 1d20 + boons/curses vs defense{{/if}}">
              {{#if ab.isAutoHit}}✦ Auto-Hit{{else}}⚔ Attack Roll{{/if}}
            </button>
          {{/if}}
          {{#if ab.dealsDamage}}
            <button type="button" class="icon-btn icon-btn--sm"
                    data-action="abilityDamageRoll" data-item-id="{{ab.id}}"
                    title="Roll damage using the ability's parsed formula">
              💥 Damage Roll
            </button>
          {{/if}}
        </div>

        {{!-- Power die tracked on the ability (Odinforce, Soul Blade…): set out at its
             starting value, tick up/down, discard at 0 (manual glossary "Power Die"). --}}
        {{#if ab.powerDie}}
          <div class="icon-trait__quick icon-power-die-widget" title="Power die unique to this item. Set it out when the text says so, tick it up or down as the text tells you; at 0 it is discarded.">
            <span class="icon-trait__quick-label">🎲 Power die d{{ab.powerDie.faces}}</span>
            {{#if ab.powerDie.active}}
              <span class="icon-power-die icon-power-die--inline">
                <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieTick" data-item-id="{{ab.id}}" data-delta="-1" {{#unless ../isEditable}}disabled{{/unless}} title="Tick down">−</button>
                <span class="icon-power-die__value">{{ab.powerDie.value}}</span>
                <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieTick" data-item-id="{{ab.id}}" data-delta="1" {{#unless ../isEditable}}disabled{{/unless}} title="Tick up (max {{ab.powerDie.faces}})">+</button>
              </span>
              <button type="button" class="icon-btn icon-btn--sm icon-btn--roll" data-action="itemPowerDieRoll" data-item-id="{{ab.id}}" title="Roll 1d{{ab.powerDie.faces}}">🎲</button>
              <button type="button" class="icon-btn icon-btn--sm" data-action="itemPowerDieSet" data-item-id="{{ab.id}}" data-value="0" {{#unless ../isEditable}}disabled{{/unless}} title="Discard the die">Discard</button>
            {{else}}
              <button type="button" class="icon-btn icon-btn--sm icon-btn--primary" data-action="itemPowerDieSet" data-item-id="{{ab.id}}" data-value="{{ab.powerDie.start}}" {{#unless ../isEditable}}disabled{{/unless}}>Set out at {{ab.powerDie.start}}</button>
            {{/if}}
          </div>
        {{/if}}

        {{!-- Talent / Mastery editor — costs 1 AP per talent, 1 mastery per
             mastery unlock. Disabled when the equipped-abilities lock is on
             so a stray click during play can't change the build. --}}
        {{#if ../isEditable}}
          <div class="icon-ability-preview__editor">
            {{#if (icon-or ab.hasTalent1Raw ab.hasTalent2Raw)}}
              <label class="icon-editor-label">Talent</label>
              <select class="icon-editor-select" data-action="setAbilityTalent"
                      data-item-id="{{ab.id}}"
                      {{#if ../abilitiesLocked}}disabled{{/if}}>
                <option value="0" {{#icon-eq ab.talentSelected 0}}selected{{/icon-eq}}>— none —</option>
                {{#if ab.hasTalent1Raw}}
                  <option value="1" {{#icon-eq ab.talentSelected 1}}selected{{/icon-eq}}>Talent I</option>
                {{/if}}
                {{#if ab.hasTalent2Raw}}
                  <option value="2" {{#icon-eq ab.talentSelected 2}}selected{{/icon-eq}}>Talent II</option>
                {{/if}}
              </select>
            {{/if}}
            {{#if ab.hasMasteryRaw}}
              <label class="icon-editor-label">
                <input type="checkbox" data-action="toggleAbilityMastery"
                       data-item-id="{{ab.id}}"
                       {{#if ab.masteryUnlocked}}checked{{/if}}
                       {{#if ../abilitiesLocked}}disabled{{/if}}>
                Mastery unlocked
              </label>
            {{/if}}
            {{#if ../abilitiesLocked}}
              <p class="icon-empty"><em>Locked. Click 🔒 above to unlock.</em></p>
            {{/if}}
          </div>
        {{/if}}

        {{#if ab.hasDesc}}
          <div class="icon-ability-preview__desc">{{{ab.description}}}</div>
        {{/if}}
        {{#if ab.hasTrigger}}<p><strong>Trigger:</strong> <span class="icon-ability-preview__effect">{{{ab.trigger}}}</span></p>{{/if}}
        {{!-- Rules blocks in the book's reading order (helpers/ability-blocks.mjs):
             Hit / Miss / Area, the blocks parsed out of the description text (Effect,
             Stance, Mark…) and Charge / Heroic / …, reordered by system.blockOrder
             for the abilities the book prints in a different sequence. --}}
        {{#each ab.blocks as |b|}}
          <p {{#if b.fromText}}class="icon-ability-section"{{/if}}><strong{{#if b.tooltip}} class="icon-kw-label" data-tooltip="{{b.tooltip}}"{{/if}}>{{b.label}}:</strong> <span class="icon-ability-preview__effect">{{{b.text}}}</span></p>
        {{/each}}
        {{#if ab.hasTalent1}}<p><strong>Talent 1:</strong> <span class="icon-ability-preview__effect">{{{ab.talent1}}}</span></p>{{/if}}
        {{#if ab.hasTalent2}}<p><strong>Talent 2:</strong> <span class="icon-ability-preview__effect">{{{ab.talent2}}}</span></p>{{/if}}
        {{#if ab.hasMastery}}<p><strong>Mastery:</strong> <span class="icon-ability-preview__effect">{{{ab.mastery}}}</span></p>{{/if}}

        {{!-- Relic integration: reminder lines from the character's relics (relic-reminders.mjs) --}}
        {{#each ab.relicReminders as |rr|}}
          <p class="icon-ability-relic"><strong class="icon-ability-relic__label" data-tooltip="From the relic {{rr.relic}} (rank {{rr.rankLabel}}) — see the Relics tab">✦ {{rr.relic}} {{rr.rankLabel}}:</strong> <span class="icon-ability-preview__effect">{{{rr.text}}}</span></p>
        {{/each}}

        {{!-- Combo block — shown when ability has combo content --}}
        {{#if ab.hasCombo}}
          <div class="icon-ability-preview__combo {{#if ../comboActive}}icon-ability-preview__combo--active{{/if}}">
            <p class="icon-ability-preview__combo-label">⚡ COMBO:</p>
            <div class="icon-ability-preview__combo-text">{{{ab.comboEffect}}}</div>
          </div>
        {{/if}}
      </div>
    {{/each}}
  </div>

  {{!-- Limit Break --}}
  <div class="icon-section">
    <h3 class="icon-section__title">Limit Break</h3>
    {{#if limitBreakItem}}
      <div class="icon-limit-break icon-class--{{limitBreakItem.system.class}}"
           data-item-id="{{limitBreakItem.id}}">
        <div class="icon-limit-break__header">
          <strong>{{limitBreakItem.name}}</strong>
          <span class="icon-badge">{{limitBreakCost}}</span>
          <span class="icon-badge icon-badge--resolve">{{limitBreakItem.system.resolveCost}} Resolve</span>
          {{#if isEditable}}
            <button type="button" class="icon-btn icon-btn--remove icon-btn--inline icon-btn--corner"
                    data-action="removeItem" data-item-id="{{limitBreakItem.id}}"
                    title="Remove Limit Break">×</button>
          {{/if}}
        </div>
        <div class="icon-limit-break__effect">{{{limitBreakItem.system.effect}}}</div>
        {{#if isEditable}}
          <button type="button" class="icon-btn icon-btn--use" data-action="useLimitBreak">
            Use Limit Break
          </button>
        {{/if}}
      </div>
    {{else}}
      <p class="icon-empty">No Limit Break equipped. Drag a limit-break item here.</p>
    {{/if}}
  </div>

  {{!-- Resolve --}}
  <div class="icon-section icon-section--row">
    <div class="icon-resource-block">
      <label class="icon-resource__title">Personal Resolve</label>
      <input type="number" name="system.combat.resolve.personal"
             value="{{system.combat.resolve.personal}}" min="0"
             {{#unless isEditable}}disabled{{/unless}}>
    </div>
    <div class="icon-resource-block">
      <label class="icon-resource__title">Party Resolve</label>
      <input type="number" name="system.combat.resolve.party"
             value="{{system.combat.resolve.party}}" min="0"
             {{#unless isEditable}}disabled{{/unless}}>
    </div>
  </div>

</section>
