{{!-- clock-sheet.hbs — a board of campaign clocks (actor type "clock").
      One row per clock: name, size, segments you click to set progress,
      a note, the GM's "secret" toggle and a 💬 button to post it to chat. --}}
<div class="icon-sheet clock-sheet">

  {{!-- `.icon-band` is the diagonal backdrop, not a container: it is an EMPTY
        grid item behind the header (pointer-events: none, clip-path, negative
        margins). The real content goes beside it, as in foe-header.hbs. --}}
  <header class="icon-sheet__header clock-header" style="--band:#3a2a5e">
    <div class="icon-band"></div>

    <div class="icon-sheet__identity">
      <input class="icon-sheet__name" type="text" name="name" value="{{actor.name}}"
             placeholder="Clocks" {{#unless isEditable}}disabled{{/unless}}>
      <small class="clock-header__count">{{clocks.length}} clock{{#unless (icon-eq clocks.length 1)}}s{{/unless}}</small>
    </div>

    {{#if isEditable}}
      <button type="button" class="icon-btn icon-btn--sm clock-header__add"
              data-action="addClock" title="Add a clock">+ Clock</button>
    {{/if}}
  </header>

  <div class="icon-clock-board">
    {{#each clocks as |c|}}
      <div class="icon-clock-card {{#if c.full}}icon-clock-card--full{{/if}}" style="--clock-color:{{c.color}}">
        <div class="icon-clock-card__head">
          <input type="text" name="system.clocks.{{c.i}}.name" value="{{c.name}}"
                 placeholder="Clock name" {{#unless ../isEditable}}disabled{{/unless}}>
          <select name="system.clocks.{{c.i}}.max" class="icon-clock-size" {{#unless ../isEditable}}disabled{{/unless}}>
            {{#each c.sizes as |sz|}}
              <option value="{{sz}}" {{#icon-eq c.max sz}}selected{{/icon-eq}}>{{sz}}</option>
            {{/each}}
          </select>
          <input type="color" name="system.clocks.{{c.i}}.color" value="{{c.color}}"
                 title="Colour of this clock" {{#unless ../isEditable}}disabled{{/unless}}>
          <span class="icon-clock-card__count">{{c.value}}/{{c.max}}</span>
          <button type="button" class="icon-btn icon-btn--sm" data-action="postClock" data-index="{{c.i}}"
                  title="Post this clock to chat{{#if c.secret}} (whispered to the GM){{/if}}">💬</button>
          {{#if ../isGM}}
            <button type="button" class="icon-btn icon-btn--sm {{#if c.secret}}icon-btn--secret-on{{/if}}"
                    data-action="toggleSecret" data-index="{{c.i}}"
                    title="{{#if c.secret}}Hidden from the players — click to reveal{{else}}Visible to the players — click to hide{{/if}}">
              {{#if c.secret}}🙈{{else}}👁{{/if}}
            </button>
          {{/if}}
          {{#if ../isEditable}}
            <button type="button" class="icon-btn icon-btn--sm icon-btn--remove" data-action="removeClock"
                    data-index="{{c.i}}" title="Remove this clock">✕</button>
          {{/if}}
        </div>

        <div class="icon-clock-row">
          {{#if ../isEditable}}
            <button type="button" class="icon-btn icon-btn--sm icon-clock-adjust"
                    data-action="adjustClock" data-index="{{c.i}}" data-delta="-1" title="Back one">−</button>
          {{/if}}
          {{#each c.segments as |s|}}
            <span class="icon-clock-seg {{#if s.on}}icon-clock-seg--filled{{/if}}"
                  {{#if ../../isEditable}}data-action="setClockValue" data-index="{{c.i}}" data-segment="{{s.n}}"
                  title="Set to {{s.n}} (click the last filled one to step back)"{{/if}}></span>
          {{/each}}
          {{#if ../isEditable}}
            <button type="button" class="icon-btn icon-btn--sm icon-clock-adjust"
                    data-action="adjustClock" data-index="{{c.i}}" data-delta="1" title="Forward one">+</button>
          {{/if}}
          {{#if c.full}}<span class="icon-badge icon-badge--primary">FULL</span>{{/if}}
        </div>

        <input type="text" class="icon-clock-card__note" name="system.clocks.{{c.i}}.note" value="{{c.note}}"
               placeholder="What happens when it fills…" {{#unless ../isEditable}}disabled{{/unless}}>
      </div>
    {{else}}
      <p class="icon-wizard__empty">No clocks yet. {{#if isEditable}}Press <strong>+ Clock</strong> to start one — a quest, a threat closing in, a project in camp (pp.140-145).{{/if}}</p>
    {{/each}}
  </div>

  <div class="icon-section">
    <h3 class="icon-section-title">Notes</h3>
    {{#if isEditable}}
      <textarea name="system.notes" class="icon-editor">{{system.notes}}</textarea>
    {{else}}
      <div class="icon-editor-wrap">{{{enrichedNotes}}}</div>
    {{/if}}
  </div>

</div>
