{{!-- summon-sheet.hbs --}}
<div class="icon-sheet summon-sheet">
  <header class="icon-sheet__header summon-header">
    <div class="icon-band summon-header__band"></div>
    <img class="icon-sheet__portrait icon-sheet__portrait--sm"
         src="{{actor.img}}" alt="{{actor.name}}"
         data-edit="img" {{#unless isEditable}}disabled{{/unless}}>
    <div class="icon-sheet__identity">
      <input class="icon-sheet__name" type="text" name="name"
             value="{{actor.name}}" {{#unless isEditable}}disabled{{/unless}}>
      <div class="icon-sheet__badges">
        {{#if mapObject}}
          {{!-- An object an ability / trait put on the map (R33a): height 1-3, immune unless the GM makes it destructible (p.89) --}}
          <span class="icon-badge icon-badge--primary">Object</span>
          {{#if isEditable}}{{#unless mapObject.world}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="objectHeight" data-delta="-1" {{#unless mapObject.canLower}}disabled{{/unless}}
                    title="Lower the object by 1">−</button>
          {{/unless}}{{/if}}
          <span class="icon-badge" title="{{#if mapObject.world}}Height it is placed with; each token keeps its own (p.89){{else}}Objects are height 1-3; stacked objects can't be past height 3 (p.95){{/if}}">Height {{mapObject.height}}{{#if mapObject.world}} (as placed){{/if}}</span>
          {{#if isEditable}}{{#unless mapObject.world}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="objectHeight" data-delta="1" {{#unless mapObject.canRaise}}disabled{{/unless}}
                    title="Raise the object by 1 (Spirit Shrine: use the ability again while adjacent; Terraforming: raise height by +1)">+</button>
          {{/unless}}{{/if}}
          {{#if mapObject.aura}}<span class="icon-badge">Aura {{mapObject.aura}}</span>{{/if}}
          {{#if mapObject.destructible}}
            <span class="icon-badge">Destructible — 10 hp</span>
          {{else}}
            <span class="icon-badge icon-badge--intangible" title="Immune to damage and effects unless specified (p.89)">Immune</span>
          {{/if}}
          {{#if mapObject.isGM}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="toggleDestructible"
                    title="{{#if mapObject.destructible}}Make the object immune to damage and effects again{{else}}Destructible objects have 10 hp, are targetable like a character, automatically hit by attacks and effects, and fail all saves (p.89){{/if}}">
              {{#if mapObject.destructible}}Make immune{{else}}Make destructible{{/if}}
            </button>
            {{!-- R33a5: Foundry walls around the object, only on the GM's click --}}
            {{#if mapObject.onMap}}{{#unless mapObject.world}}
              {{#if mapObject.walls}}
                <button type="button" class="icon-btn icon-btn--sm" data-action="objectWalls"
                        title="Delete the walls around this object"><i class="fa-solid fa-border-none"></i> Remove walls</button>
              {{else}}{{#unless mapObject.noObstruction}}
                <button type="button" class="icon-btn icon-btn--sm" data-action="objectWalls"
                        title="Objects provide obstruction (p.89): put walls around it that stop movement into its space (not sight, p.92). They follow the token and go when it is deleted."><i class="fa-solid fa-border-all"></i> Add walls</button>
              {{/unless}}{{/if}}
            {{/unless}}{{/if}}
          {{/if}}
        {{else}}
          {{#if system.intangible}}
            <span class="icon-badge icon-badge--intangible">Intangible</span>
          {{else}}
            <span class="icon-badge">Tangible</span>
          {{/if}}
          {{#if isEditable}}
            <button type="button" class="icon-btn" data-action="toggleIntangible">
              Toggle Intangible
            </button>
          {{/if}}
          <span class="icon-badge">Size {{system.size}}</span>
        {{/if}}
      </div>
    </div>
  </header>

  <section class="summon-sheet__body">

    {{#if mapObject}}
      {{!-- R33a2: what the object does at the table, read from the text it comes from --}}
      <div class="icon-section icon-object-effect">
        <div class="icon-section__header">
          <h3 class="icon-section__title">Object Effect
            <small>{{#if mapObject.world}}{{#if mapObject.copies.length}}on this scene: {{mapObject.copiesLabel}}{{else}}none on this scene{{/if}}{{else}}{{#if mapObject.below}}height {{mapObject.height}} on height {{mapObject.below}} — total height {{mapObject.total}}{{else}}total height {{mapObject.total}}{{/if}}{{/if}}</small></h3>
          <button type="button" class="icon-btn icon-btn--sm" data-action="objectToChat"
                  title="Post the object's rules and what is on now to chat"><i class="fa-solid fa-comment"></i> Chat</button>
          {{#if isEditable}}{{#if mapObject.onMap}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="objectRemove"
                    title="{{#if mapObject.pickUp}}Pick the weapon up: removes the object and ends its effect{{else}}Remove the object from the map{{/if}} (objects stacked on it come down)">
              {{#if mapObject.pickUp}}<i class="fa-solid fa-hand"></i> Pick up{{else}}<i class="fa-solid fa-trash"></i> Remove{{/if}}
            </button>
          {{/if}}{{/if}}
          {{!-- R33a3: Geyser's eruption, Megamushroom's blessing token --}}
          {{#if mapObject.onMap}}
            {{#if mapObject.erupt}}
              <button type="button" class="icon-btn icon-btn--sm" data-action="objectErupt"
                      title="Erupt: a chat card names the characters to remove and place{{#if mapObject.erupt.place}} {{mapObject.erupt.place}} spaces away{{/if}}, then the object is removed{{#if mapObject.erupt.summon}} and a {{mapObject.erupt.summon}} goes in its space{{/if}} (p.232)"><i class="fa-solid fa-water"></i> Erupt</button>
            {{/if}}
            {{#if mapObject.blessing}}{{#unless mapObject.blessing.taken}}
              <button type="button" class="icon-btn icon-btn--sm" data-action="objectBlessing"
                      title="The selected character (yours or an ally entering its space) picks the blessing token up: +1 Blessed. The object stays."><i class="fa-solid fa-hand-sparkles"></i> Pick up blessing</button>
            {{/unless}}{{/if}}
            {{!-- R33a4: Underway's teleport, Aethershard Talent I's move --}}
            {{#if mapObject.portal}}
              <button type="button" class="icon-btn icon-btn--sm" data-action="objectTeleport"
                      title="Select the token next to another portal, then click a highlighted free space next to this one (p.168)"><i class="fa-solid fa-dungeon"></i> Teleport here</button>
            {{/if}}
            {{#if isEditable}}{{#if mapObject.moves.relocate}}
              <button type="button" class="icon-btn icon-btn--sm" data-action="objectRelocate"
                      title="{{mapObject.moves.relocate.source}}: when you spend Aether, first move it to a highlighted free space up to range {{mapObject.moves.relocate.range}} (p.210)"><i class="fa-solid fa-up-down-left-right"></i> Move</button>
            {{/if}}{{/if}}
          {{/if}}
        </div>
        {{#if mapObject.world}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-circle-info"></i> This is the template in the Map Objects folder: each token on the map is its own copy, with its own height. Double-click a token to see or change its height.</p>
        {{/if}}
        {{#if mapObject.blessing}}
          <p><strong>Blessing token:</strong> {{#if mapObject.blessing.taken}}picked up{{else}}on it{{/if}}.</p>
        {{/if}}
        {{#if mapObject.plantNote}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-seedling"></i> Counts as a plant (p.184): its space is dangerous terrain that only affects foes, and you or an ally entering it can pick up the blessing token. Unlike a plant, it stays when the token is picked up.</p>
        {{/if}}
        {{#if mapObject.areaTrigger}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-gem"></i> Caught in an area you place: the area card asks to deal {{mapObject.areaTrigger.amount}} {{mapObject.areaTrigger.type}} damage per shard and destroy them{{#if mapObject.areaTrigger.aether}} (+{{mapObject.areaTrigger.aether}} Aether){{/if}}.</p>
        {{/if}}
        {{#if mapObject.rampart}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-shield-halved"></i> Spaces adjacent to it have rampart (the Aura 1 around it): foes cannot enter or exit them by dashing, flying or teleporting (p.104).</p>
        {{/if}}
        {{#if mapObject.pickUpNear}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-hand"></i> Moving {{#if mapObject.creatorName}}{{mapObject.creatorName}}{{else}}its creator{{/if}} into or out of a space adjacent to it asks to pick it up; starting the turn there is reminded in chat.</p>
        {{/if}}
        {{#if mapObject.portal}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-dungeon"></i> Moving a character (not a foe) next to it asks to teleport next to another one{{#if mapObject.moves.pullFoes}}; a foe ending its turn next to it is reminded in chat ({{mapObject.moves.pullFoes.source}}){{/if}}.</p>
        {{/if}}
        {{#if mapObject.moves.adjacentGain}}
          <p class="icon-object-effect__note"><i class="fa-solid fa-ghost"></i> {{mapObject.moves.adjacentGain.source}}: starting or ending the turn adjacent to it gives {{mapObject.creatorName}} {{mapObject.moves.adjacentGain.status}} {{mapObject.moves.adjacentGain.until}} (applied at the turn change).</p>
        {{/if}}
        {{#if mapObject.noAttack}}
          <p class="icon-object-effect__warn"><i class="fa-solid fa-ban"></i> While this object is on the map, {{#if mapObject.creatorName}}{{mapObject.creatorName}}{{else}}its creator{{/if}} cannot attack.</p>
        {{/if}}
        {{#if mapObject.benefits.length}}
          <ul class="icon-object-effect__benefits">
            {{#each mapObject.benefits as |b|}}
              <li class="{{#if b.active}}is-active{{else}}is-inactive{{/if}}"
                  title="{{#if b.active}}On: total height {{../mapObject.total}}{{else}}Needs total height {{b.label}}{{/if}} (including the objects it is stacked on)">
                <strong>{{b.label}}:</strong> {{b.text}}</li>
            {{/each}}
          </ul>
        {{/if}}
        {{#if mapObject.perHeight}}
          <p><strong>{{mapObject.perHeight.source}}:</strong> height {{mapObject.height}} → {{mapObject.perHeight.amount}} {{mapObject.perHeight.type}} damage ×{{mapObject.perHeight.times}}.</p>
        {{/if}}
        {{#if mapObject.enrichedRules}}<div class="icon-editor-wrap">{{{mapObject.enrichedRules}}}</div>{{/if}}
        {{#each mapObject.enrichedUpgrades as |u|}}
          <p><strong>{{u.source}}:</strong> {{{u.html}}}</p>
        {{/each}}
      </div>
    {{/if}}

    {{#if isEditable}}
      <p class="summon-sheet__drop-hint">
        <i class="fa-solid fa-lightbulb"></i> Drop an <strong>Actor</strong> here to set the summoner, or drop an
        <strong>Ability</strong> item to auto-fill the Source Ability and
        Summon Action text.
      </p>
    {{/if}}

    <div class="icon-section">
      <div class="icon-field-row">
        <label>Summoner</label>
        <span>{{summonerName}}</span>
        {{#if isEditable}}
          <input type="text" name="system.summonerActorId"
                 value="{{system.summonerActorId}}" placeholder="Actor ID (or drop an Actor)">
        {{/if}}
      </div>
      <div class="icon-field-row">
        <label>Source Ability</label>
        <input type="text" name="system.sourceAbilityName"
               value="{{system.sourceAbilityName}}" placeholder="Ability name (or drop an Item)"
               {{#unless isEditable}}disabled{{/unless}}>
      </div>
      {{#unless mapObject}}
      <div class="icon-field-row">
        <label>Speed</label>
        <input type="number" name="system.speed" value="{{system.speed}}"
               min="0" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      {{/unless}}
      {{#unless system.intangible}}
        <div class="icon-field-row">
          <label>HP</label>
          <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0"
                 {{#unless isEditable}}disabled{{/unless}}>
          /
          <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0"
                 {{#unless isEditable}}disabled{{/unless}}>
        </div>
        <div class="icon-field-row">
          <label>Defense</label>
          <input type="number" name="system.defense" value="{{system.defense}}"
                 {{#unless isEditable}}disabled{{/unless}}>
        </div>
      {{/unless}}
    </div>

    {{#unless mapObject}}
    <div class="icon-section">
      <div class="icon-section__header">
        <h3 class="icon-section__title">Summon Action</h3>
        {{#if hasAction}}
          <button type="button" class="icon-btn icon-btn--roll"
                  data-action="rollSummonAttack"
                  title="Roll attack"><i class="fa-solid fa-hand-fist"></i> Attack</button>
          {{#if dealsDamage}}
            <button type="button" class="icon-btn icon-btn--roll"
                    data-action="rollSummonDamage"
                    title="Roll damage"><i class="fa-solid fa-burst"></i> Damage</button>
          {{/if}}
        {{/if}}
      </div>
      <div class="icon-editor-wrap">{{{enrichedSummonAction}}}</div>
      {{#if isEditable}}
        <textarea name="system.summonAction" class="icon-editor">{{system.summonAction}}</textarea>
      {{/if}}
    </div>
    {{/unless}}

    <div class="icon-section">
      <h3 class="icon-section__title">{{#if mapObject}}Object Rules <small>(the text it comes from)</small>{{else}}Passive Effect{{/if}}</h3>
      <div class="icon-editor-wrap">{{{enrichedSummonEffect}}}</div>
      {{#if isEditable}}
        <textarea name="system.summonEffect" class="icon-editor">{{system.summonEffect}}</textarea>
      {{/if}}
    </div>

    {{#if isEditable}}
      <div class="icon-section icon-section--saves">
        <h3 class="icon-section__title">Saves <small>1d20, 10+ clears the status</small></h3>
        <div class="icon-save-buttons">
          {{#each saveableStatuses as |st|}}
            <button type="button" class="icon-btn icon-btn--sm icon-save-btn"
                    data-action="rollSave" data-effect-uuid="{{st.uuid}}"
                    title="Roll a save against {{st.name}} — on a 10+ it is removed"><i class="fa-solid fa-dice-d20"></i> {{st.name}}</button>
          {{else}}
            <span class="notes" style="font-size:.85em;color:#c0b898">No status to save against right now.</span>
          {{/each}}
          <button type="button" class="icon-btn icon-btn--sm" data-action="rollSave"
                  title="Roll a save against something else (type the status in the dialog)"><i class="fa-solid fa-shield-halved"></i> Save vs…</button>
        </div>
      </div>
    {{/if}}

    <div class="icon-section">
      <h3 class="icon-section__title">Notes</h3>
      <div class="icon-editor-wrap">{{{enrichedNotes}}}</div>
      {{#if isEditable}}
        <textarea name="system.notes" class="icon-editor">{{system.notes}}</textarea>
      {{/if}}
    </div>

  </section>
</div>
