{{!-- summon-sheet.hbs --}}
<div class="icon-sheet summon-sheet">
  <header class="icon-sheet__header summon-header">
    <div class="icon-band summon-header__band"></div>
    <img class="icon-sheet__portrait icon-sheet__portrait--sm"
         src="{{actor.img}}" alt="{{actor.name}}"
         data-edit="img" {{#unless isEditable}}disabled{{/unless}}>
    <div class="icon-sheet__identity">
      <input class="icon-sheet__name" type="text" name="name"
             value="{{actor.name}}" {{#unless isEditable}}disabled{{/unless}}>
      <div class="icon-sheet__badges">
        {{#if mapObject}}
          {{!-- An object an ability / trait put on the map (R33a): height 1-3, immune unless the GM makes it destructible (p.89) --}}
          <span class="icon-badge icon-badge--primary">Object</span>
          {{#if isEditable}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="objectHeight" data-delta="-1" {{#unless mapObject.canLower}}disabled{{/unless}}
                    title="Lower the object by 1">−</button>
          {{/if}}
          <span class="icon-badge" title="Objects are height 1-3; stacked objects can't be past height 3 (p.95)">Height {{mapObject.height}}</span>
          {{#if isEditable}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="objectHeight" data-delta="1" {{#unless mapObject.canRaise}}disabled{{/unless}}
                    title="Raise the object by 1 (Spirit Shrine: use the ability again while adjacent; Terraforming: raise height by +1)">+</button>
          {{/if}}
          {{#if mapObject.aura}}<span class="icon-badge">Aura {{mapObject.aura}}</span>{{/if}}
          {{#if mapObject.destructible}}
            <span class="icon-badge">Destructible — 10 hp</span>
          {{else}}
            <span class="icon-badge icon-badge--intangible" title="Immune to damage and effects unless specified (p.89)">Immune</span>
          {{/if}}
          {{#if mapObject.isGM}}
            <button type="button" class="icon-btn icon-btn--sm" data-action="toggleDestructible"
                    title="{{#if mapObject.destructible}}Make the object immune to damage and effects again{{else}}Destructible objects have 10 hp, are targetable like a character, automatically hit by attacks and effects, and fail all saves (p.89){{/if}}">
              {{#if mapObject.destructible}}Make immune{{else}}Make destructible{{/if}}
            </button>
          {{/if}}
        {{else}}
          {{#if system.intangible}}
            <span class="icon-badge icon-badge--intangible">Intangible</span>
          {{else}}
            <span class="icon-badge">Tangible</span>
          {{/if}}
          {{#if isEditable}}
            <button type="button" class="icon-btn" data-action="toggleIntangible">
              Toggle Intangible
            </button>
          {{/if}}
          <span class="icon-badge">Size {{system.size}}</span>
        {{/if}}
      </div>
    </div>
  </header>

  <section class="summon-sheet__body">

    {{#if isEditable}}
      <p class="summon-sheet__drop-hint">
        <i class="fa-solid fa-lightbulb"></i> Drop an <strong>Actor</strong> here to set the summoner, or drop an
        <strong>Ability</strong> item to auto-fill the Source Ability and
        Summon Action text.
      </p>
    {{/if}}

    <div class="icon-section">
      <div class="icon-field-row">
        <label>Summoner</label>
        <span>{{summonerName}}</span>
        {{#if isEditable}}
          <input type="text" name="system.summonerActorId"
                 value="{{system.summonerActorId}}" placeholder="Actor ID (or drop an Actor)">
        {{/if}}
      </div>
      <div class="icon-field-row">
        <label>Source Ability</label>
        <input type="text" name="system.sourceAbilityName"
               value="{{system.sourceAbilityName}}" placeholder="Ability name (or drop an Item)"
               {{#unless isEditable}}disabled{{/unless}}>
      </div>
      {{#unless mapObject}}
      <div class="icon-field-row">
        <label>Speed</label>
        <input type="number" name="system.speed" value="{{system.speed}}"
               min="0" {{#unless isEditable}}disabled{{/unless}}>
      </div>
      {{/unless}}
      {{#unless system.intangible}}
        <div class="icon-field-row">
          <label>HP</label>
          <input type="number" name="system.hp.value" value="{{system.hp.value}}" min="0"
                 {{#unless isEditable}}disabled{{/unless}}>
          /
          <input type="number" name="system.hp.max" value="{{system.hp.max}}" min="0"
                 {{#unless isEditable}}disabled{{/unless}}>
        </div>
        <div class="icon-field-row">
          <label>Defense</label>
          <input type="number" name="system.defense" value="{{system.defense}}"
                 {{#unless isEditable}}disabled{{/unless}}>
        </div>
      {{/unless}}
    </div>

    {{#unless mapObject}}
    <div class="icon-section">
      <div class="icon-section__header">
        <h3 class="icon-section__title">Summon Action</h3>
        {{#if hasAction}}
          <button type="button" class="icon-btn icon-btn--roll"
                  data-action="rollSummonAttack"
                  title="Roll attack"><i class="fa-solid fa-hand-fist"></i> Attack</button>
          {{#if dealsDamage}}
            <button type="button" class="icon-btn icon-btn--roll"
                    data-action="rollSummonDamage"
                    title="Roll damage"><i class="fa-solid fa-burst"></i> Damage</button>
          {{/if}}
        {{/if}}
      </div>
      <div class="icon-editor-wrap">{{{enrichedSummonAction}}}</div>
      {{#if isEditable}}
        <textarea name="system.summonAction" class="icon-editor">{{system.summonAction}}</textarea>
      {{/if}}
    </div>
    {{/unless}}

    <div class="icon-section">
      <h3 class="icon-section__title">{{#if mapObject}}Object Rules <small>(the text it comes from)</small>{{else}}Passive Effect{{/if}}</h3>
      <div class="icon-editor-wrap">{{{enrichedSummonEffect}}}</div>
      {{#if isEditable}}
        <textarea name="system.summonEffect" class="icon-editor">{{system.summonEffect}}</textarea>
      {{/if}}
    </div>

    {{#if isEditable}}
      <div class="icon-section icon-section--saves">
        <h3 class="icon-section__title">Saves <small>1d20, 10+ clears the status</small></h3>
        <div class="icon-save-buttons">
          {{#each saveableStatuses as |st|}}
            <button type="button" class="icon-btn icon-btn--sm icon-save-btn"
                    data-action="rollSave" data-effect-uuid="{{st.uuid}}"
                    title="Roll a save against {{st.name}} — on a 10+ it is removed"><i class="fa-solid fa-dice-d20"></i> {{st.name}}</button>
          {{else}}
            <span class="notes" style="font-size:.85em;color:#c0b898">No status to save against right now.</span>
          {{/each}}
          <button type="button" class="icon-btn icon-btn--sm" data-action="rollSave"
                  title="Roll a save against something else (type the status in the dialog)"><i class="fa-solid fa-shield-halved"></i> Save vs…</button>
        </div>
      </div>
    {{/if}}

    <div class="icon-section">
      <h3 class="icon-section__title">Notes</h3>
      <div class="icon-editor-wrap">{{{enrichedNotes}}}</div>
      {{#if isEditable}}
        <textarea name="system.notes" class="icon-editor">{{system.notes}}</textarea>
      {{/if}}
    </div>

  </section>
</div>
