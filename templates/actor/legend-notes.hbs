{{!-- legend-notes.hbs — Notes tab for Legends.
     Description / Tactics / Lore / Loot as plain textareas in edit mode,
     enriched preview only when read-only. --}}
<section class="tab icon-tab icon-tab--legend-notes {{tab.cssClass}}" data-tab="notes" data-group="primary">

  <div class="icon-section">
    <h3 class="icon-section__title">Description</h3>
    {{#if isEditable}}
      <textarea name="system.description" class="icon-editor legend-notes__textarea"
                placeholder="Lore-friendly description of this Legend">{{system.description}}</textarea>
    {{else}}
      <div class="icon-editor-wrap">{{{enrichedDescription}}}</div>
    {{/if}}
  </div>

  <div class="icon-section">
    <h3 class="icon-section__title">Tactics</h3>
    {{#if isEditable}}
      <textarea name="system.tactics" class="icon-editor legend-notes__textarea"
                placeholder="GM tactics, opening moves, weak points">{{system.tactics}}</textarea>
    {{else}}
      <div class="icon-editor-wrap">{{{enrichedTactics}}}</div>
    {{/if}}
  </div>

  <div class="icon-section">
    <h3 class="icon-section__title">Lore</h3>
    {{#if isEditable}}
      <textarea name="system.lore" class="icon-editor legend-notes__textarea"
                placeholder="Background, motivations, history">{{system.lore}}</textarea>
    {{else}}
      <div class="icon-editor-wrap">{{{enrichedLore}}}</div>
    {{/if}}
  </div>

  <div class="icon-section">
    <h3 class="icon-section__title">Loot</h3>
    {{#if isEditable}}
      <textarea name="system.loot" class="icon-editor legend-notes__textarea"
                placeholder="Treasure / dust / relics dropped on defeat">{{system.loot}}</textarea>
    {{else}}
      <div class="icon-editor-wrap">{{{enrichedLoot}}}</div>
    {{/if}}
  </div>

</section>
